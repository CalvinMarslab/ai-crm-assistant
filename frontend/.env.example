# API base URL.
#
# Leave this unset for local development: Vite proxies /api to the backend on
# port 8000, so the browser stays on one origin and needs no CORS setup.
#
# Set it in production to the deployed API, including the /api/v1 suffix. The
# backend must list this frontend's origin in its own FRONTEND_URL, which is
# what its CORS allow-list is built from.
#
# VITE_API_URL=https://your-app.laravel.cloud/api/v1

VITE_API_URL=http://127.0.0.1:8000/api/v1
